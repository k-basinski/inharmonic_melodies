library(tidyverse)
library(psych)
library(readr)
library(lme4)
library(emmeans)
library(ggplot2)
data <- read_csv("/Users/zosiamikolajczak/ANL/ANL_inharmonic_melodies/results/results.csv",
data <- read_csv("/Users/zosiamikolajczak/ANL/ANL_inharmonic_melodies/results/results.csv")
data <- read_csv("/Users/zosiamikolajczak/ANL/ANL_inharmonic_melodies/results/results.csv")
data
View(data)
data_A <- data %>% filter(model == "A")
formula <- c("r ~ cond * group + (1|pid)")
formula0 <- c("r ~ (1|pid)")
m1 <- lmer(formula, dane)
m1 <- lmer(formula, data_A)
summary(m1)
# porownanie modeli
anova(m0, m1)
m0 <- lmer(formula0, data_A)
# porownanie modeli
anova(m0, m1)
anova(m1)
em <- emmeans(m1, "cond")
pairs(em)
em <- emmeans(m1, "cond", "group")
pairs(em)
data_A %>%
ggplot( aes(x=group, y=r, fill=cond)) +
geom_violin(width=1.4) +
geom_boxplot(width=0.1, color="grey", alpha=0.2) +
scale_fill_viridis(discrete = TRUE) +
theme_ipsum() +
theme(
legend.position="none",
plot.title = element_text(size=11)
) +
ggtitle("A Violin wrapping a boxplot") +
xlab("")
